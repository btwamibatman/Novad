PROJECT_NAME=Document Processing API
# Keep development locally. Use production only behind HTTPS.
ENVIRONMENT=development
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
POSTGRES_USER=document_api_user
POSTGRES_PASSWORD=document_api_password
POSTGRES_DB=document_api
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://document_api_user:document_api_password@db:5432/document_api
STORAGE_DIR=storage/uploads
MAX_UPLOAD_SIZE_BYTES=52428800
MAX_REQUEST_SIZE_BYTES=57671680
MAX_PDF_PAGES=100
# Production automatically adds the required __Host- prefix.
SESSION_COOKIE_NAME=document_session
SESSION_TTL_MINUTES=120
SESSION_CLEANUP_INTERVAL_SECONDS=900
SESSION_STORAGE_QUOTA_BYTES=524288000
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_THINKING_BUDGET=0
# Change to paid only when this API project is actually covered by Gemini Paid Services.
GEMINI_SERVICE_TIER=unpaid
AI_SUMMARY_MAX_CHARS=12000
AI_SUMMARY_MAX_OUTPUT_TOKENS=1800
AI_CHAT_TIMEOUT_SECONDS=20
AI_REQUEST_TIMEOUT_SECONDS=45
AI_MAX_PDF_BYTES=52428800
AI_FILE_PROCESSING_TIMEOUT_SECONDS=120
AI_JOB_MAX_ATTEMPTS=4
AI_JOB_STALE_SECONDS=300
AI_RETRY_BASE_SECONDS=5
AI_PROVIDER_MIN_REQUEST_INTERVAL_SECONDS=12
CONTENT_REVIEW_QUICK_MAX_CHARS=50000
CONTENT_REVIEW_BATCH_MAX_CHARS=10000
CONTENT_REVIEW_THOROUGH_MAX_BATCHES=6
CONTENT_REVIEW_MAX_OUTPUT_TOKENS=1800
LAYOUT_REVIEW_MAX_PAGES=3
LAYOUT_REVIEW_DPI=150
LAYOUT_REVIEW_MIN_DPI=72
LAYOUT_REVIEW_MAX_OUTPUT_TOKENS=1000
LAYOUT_REVIEW_MAX_PIXELS_PER_PAGE=8000000
LAYOUT_REVIEW_MAX_INLINE_BYTES=12582912
OCR_LANGUAGES=rus+kaz+eng
OCR_MIN_TEXT_SIGNAL_CHARS=30
OCR_RENDER_DPI=300
OCR_MIN_RENDER_DPI=180
OCR_MAX_PIXELS_PER_PAGE=20000000
OCR_MIN_MEAN_CONFIDENCE=70
OCR_HIGH_CONFIDENCE=85
OCR_LOW_WORD_CONFIDENCE=60
OCR_MAX_LOW_CONFIDENCE_RATIO=0.25
OCR_CANDIDATE_SIMILARITY=0.90
OCR_PAGE_TIMEOUT_SECONDS=45
ANALYSIS_WORKER_POLL_SECONDS=1
PII_MASKING_ENABLED=true
PII_NER_LANGUAGES=kk,ru,en
PII_MODEL_DIR=/opt/stanza_resources
